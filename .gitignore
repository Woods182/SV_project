# Strict allowlist: ignore everything by default.
*

# Keep directories visible so allowed files below can be discovered.
!*/

# RTL source and include files.
!*.sv
!*.svh
!*.v
!*.vh

# Documentation and source material.
!*.md
!*.pdf

# Build metadata explicitly requested for version control.
!/Makefile
!*.f

# Keep this policy itself under version control.
!.gitignore
